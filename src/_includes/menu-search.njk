<dialog id="article-search" class="menu-search" aria-labelledby="article-search-title" data-site-search data-search-empty-message="Search by topic, question or idea.">
  <header class="menu-search__header">
    <div>
      <p class="menu-search__eyebrow mono">Essays &amp; perspectives</p>
      <h2 id="article-search-title">Explore the ideas.</h2>
    </div>
    <button class="menu-search__icon-button" type="button" data-search-close aria-label="Close search">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg>
    </button>
  </header>
  <form role="search" class="menu-search__form">
    <label class="menu-search__label" for="article-search-query">Search published insights</label>
    <div class="menu-search__controls">
      <svg class="menu-search__magnifier" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4 4"/></svg>
      <input id="article-search-query" type="search" name="q" data-search-query autocomplete="off" placeholder="What’s on your mind?" autofocus aria-describedby="editorial-search-status">
      <button class="menu-search__icon-button" type="reset" aria-label="Clear search">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg>
      </button>
      <button class="menu-search__icon-button menu-search__submit" type="submit" aria-label="Search insights">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 12h16m-6-6 6 6-6 6"/></svg>
      </button>
    </div>
  </form>
  <p id="editorial-search-status" data-search-status role="status" aria-live="polite">Search by topic, question or idea.</p>
  <button class="menu-search__retry" type="button" data-search-retry hidden>Try loading again</button>
  <ul data-search-results aria-label="Matching insights"></ul>
</dialog>
